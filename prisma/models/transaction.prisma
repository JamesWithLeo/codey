model Order {
  id         Int                @id @unique @default(autoincrement())
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  user_id    String?
  status     TRANSACTION_STATUS @default(pending)
  totalAmount Decimal            @db.Decimal(10, 2) @map("total_amount")
  isPaid      Boolean            @default(false)    @map("is_paid")
  // source     TRANSACTION_SOURCE @default(ONLINE)
  orderItems OrderItem[]            @relation("OrderToOrderItems")
  users      User?             @relation("UserToOrders", fields: [user_id], references: [id])

  @@map("order")
}

model OrderItem {
  id             Int          @id @unique @default(autoincrement())
  quantity       Int
  subtotal      Decimal  @db.Decimal(10, 2) // quantity * pricePerUnit

  
  pricePerUnit  Decimal  @db.Decimal(10, 2) @map("price_per_unit")

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  product_id     Int
  product        product      @relation("ProductOrderItems", fields: [product_id], references: [id])

  transaction_id Int
  transaction    Order  @relation("OrderToOrderItems", fields: [transaction_id], references: [id], onDelete: Cascade)

  @@map("OrderItem")
}


enum TRANSACTION_STATUS {
  pending
  shipping
  delivered
  canceled
  completed
  deleted
}
